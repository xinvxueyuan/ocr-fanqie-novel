# =============================================================================
# ocr-fanqie-novel — Environment Configuration Example
# =============================================================================
# Copy this file to `.env` and adjust values for your deployment.
# Every variable below is read by either:
#   - NoneBot2 core (HOST / PORT / DRIVER / SUPERUSERS / ...)
#   - nonebot_plugin_localstore (LOCALSTORE_USE_CWD)
#   - src/plugins/nonebot_plugin_ocr_fanqie_novel/config.py (FANQIE_*)
# Inline comments reference the source field name that consumes each var.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. NoneBot Core
# Refs: nonebot.config.Config (NoneBot2 global config)
# -----------------------------------------------------------------------------

# NoneBot2 environment selection. "prod" loads .env, "dev" loads .env.dev,
# "test" loads .env.test.
ENVIRONMENT=prod                              # nonebot.config.Config.environment

# Driver selection. `~` prefix activates default config for each driver.
# 本项目通过反向 WebSocket 接收 OneBot V11 事件，需保留 fastapi + websockets。
DRIVER=~fastapi+~httpx+~websockets           # nonebot.config.Config.driver

# FastAPI server bind address and port. OneBot 实现（如 NapCat / go-cqhttp）
# 通过反向 WebSocket 连接到此地址的 /onebot/v11/ws 路径。
HOST=0.0.0.0                                 # nonebot.config.Config.host
PORT=8080                                    # nonebot.config.Config.port

# Bot nickname(s). First entry becomes the primary nickname.
NICKNAME=ocr-fanqie-novel                    # nonebot.config.Config.nickname

# NoneBot2 core superuser list. 超级用户可执行所有管理员命令。
SUPERUSERS=["123456789"]                      # nonebot.config.Config.superusers

# Logging level. One of: TRACE / DEBUG / INFO / WARNING / ERROR / CRITICAL.
LOG_LEVEL=INFO                               # nonebot.config.Config.log_level

# Command prefix characters. Empty string allows no-prefix commands.
COMMAND_START=["/", ""]                       # nonebot.config.Config.command_start

# Command argument separators.
COMMAND_SEP=[".", " "]                        # nonebot.config.Config.command_sep

# FastAPI OpenAPI / Swagger / ReDoc endpoints. Set to empty for production.
FASTAPI_OPENAPI_URL=/openapi.json            # nonebot.config.Config.fast_api_openapi_url
FASTAPI_DOCS_URL=/docs                        # nonebot.config.Config.fast_api_docs_url
FASTAPI_REDOC_URL=/redoc                      # nonebot.config.Config.fast_api_redoc_url


# -----------------------------------------------------------------------------
# 2. Localstore Paths
# Refs: nonebot_plugin_localstore (LOCALSTORE_USE_CWD)
# -----------------------------------------------------------------------------

# Where nonebot_plugin_localstore stores plugin data / config / cache.
# true  -> project cwd (recommended for development)
# false -> user home directory
LOCALSTORE_USE_CWD=true                      # nonebot_plugin_localstore::LOCALSTORE_USE_CWD


# -----------------------------------------------------------------------------
# 3. OCR 验证插件
# Refs: config.py::Config
# -----------------------------------------------------------------------------

# 需要执行入群验证的群号集合。空集合表示所有群都启用验证。
# 注意：群范围主要由放行策略 TOML 中的群节点决定（配置了节点的群才验证）。
# Strict JSON syntax.
FANQIE_VERIFY_GROUPS=[]                      # config.py::Config.fanqie_verify_groups

# 接收验证失败通知、可执行 /kick /keep 命令的管理员 QQ 号集合。
FANQIE_ADMIN_IDS=[]                          # config.py::Config.fanqie_admin_ids

# 新成员入群后发送的提示消息（全局默认；单个群可在策略 TOML 的群节点下
# 用 welcome_message 字段覆盖）。
FANQIE_WELCOME_MESSAGE=欢迎新人进群，记得看先去群公告或群文件教程，如果需要留下需要发带有阅读时长的书评。为了验证您是真实的读者，请发送一张您在番茄小说发布的「书评详情页」截图（需显示顶部「书评详情」标题、您的书评及「我」徽章），直接截取手机整个屏幕即可。谢谢配合！
                                            # config.py::Config.fanqie_welcome_message

# 等待新成员发送截图的超时时间（秒）。超时未响应按验证失败处理并通知管理员决策。
FANQIE_RESPONSE_TIMEOUT=600                  # config.py::Config.fanqie_response_timeout

# 识别失败的允许尝试次数。达上限按验证失败处理并通知管理员决策。
FANQIE_MAX_ATTEMPTS=3                        # config.py::Config.fanqie_max_attempts

# 验证失败（超时/识别失败达上限/综合判断不通过）时是否私信通知管理员决定通过或踢出。
FANQIE_NOTIFY_ADMIN=true                     # config.py::Config.fanqie_notify_admin

# 通知管理员后等待其决策的超时时间（秒）。超时未处理将在群内通报并移出该成员。
FANQIE_ADMIN_DECISION_TIMEOUT=57600          # config.py::Config.fanqie_admin_decision_timeout (默认 16 小时)

# 待管理员决策成员被移出前，提前提醒该成员的秒数列表（升序）。
# 默认 [3600, 300] 表示最后 1 小时、5 分钟各提醒一次其及时重审。
# FANQIE_REMIND_BEFORE_KICK=[3600, 300]       # config.py::Config.fanqie_remind_before_kick

# 普通群成员（非群管理/群主）通过“重审”命令重新发起验证的最大次数；
# 管理员发起的重审不受此限制。达到上限后需管理员处理。
FANQIE_REVIEW_MAX_TIMES=2                    # config.py::Config.fanqie_review_max_times

# FR4 综合判断中有效书名的最大字符数。
FANQIE_BOOK_NAME_MAX_LEN=100                 # config.py::Config.fanqie_book_name_max_len

# 放行策略 TOML 文件路径；留空使用 localstore 配置目录。
# FANQIE_VERIFICATION_POLICY_PATH=            # config.py::Config.fanqie_verification_policy_path

# 是否启用消息与审计记录存储。
FANQIE_MESSAGE_STORE_ENABLED=true            # config.py::Config.fanqie_message_store_enabled

# 文本摘要的最大字符数。
FANQIE_MESSAGE_STORE_SUMMARY_LIMIT=500       # config.py::Config.fanqie_message_store_summary_limit

# 是否在关闭时清理过期记录。
FANQIE_MESSAGE_STORE_CLEANUP_ENABLED=true    # config.py::Config.fanqie_message_store_cleanup_enabled

# 记录的保留天数。
FANQIE_MESSAGE_STORE_RETENTION_DAYS=7        # config.py::Config.fanqie_message_store_retention_days

# 是否记录平台 API 调用审计。
FANQIE_MESSAGE_STORE_RECORD_API_CALLS=false  # config.py::Config.fanqie_message_store_record_api_calls

# 是否允许群内管理员（admin/群主）使用 /keep、/kick 等命令。
# true 时除配置的管理员外，群管理员与群主也可执行；false 仅配置管理员可执行。
FANQIE_ALLOW_GROUP_ADMIN_COMMANDS=true       # config.py::Config.fanqie_allow_group_admin_commands

# 是否启用「私聊发图完成验证」通道。false 时停用私聊图片验证与
# 「验证 <群号>」选群命令，仅保留群内验证。
FANQIE_PRIVATE_VERIFY_ENABLED=true           # config.py::Config.fanqie_private_verify_enabled


# -----------------------------------------------------------------------------
# 4. PaddleOCR 云端 API（PP-OCRv6）
# Refs: config.py::Config
# -----------------------------------------------------------------------------

# PaddleOCR 云端任务提交地址。留空使用官方默认：
# https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
FANQIE_OCR_API_URL=                          # config.py::Config.fanqie_ocr_api_url

# 调用云端 OCR API 的认证令牌（Bearer Token）。
FANQIE_OCR_API_TOKEN=your-token-here         # config.py::Config.fanqie_ocr_api_token

# 请求云端 OCR API 的单次 HTTP 超时时间（秒）。
FANQIE_OCR_TIMEOUT=15                        # config.py::Config.fanqie_ocr_timeout

# 等待 OCR 任务完成（轮询）的总超时时间（秒）。
FANQIE_OCR_POLL_TIMEOUT=120                  # config.py::Config.fanqie_ocr_poll_timeout

# 使用的 PaddleOCR 模型名称（如 PP-OCRv6）。
FANQIE_OCR_MODEL=PaddleOCR-VL-1.6            # config.py::Config.fanqie_ocr_model

# 多模型并行识别的模型集合（JSON 数组）。多模型结果按字段逐项融合，
# 置信度阈值见 FANQIE_SIMILARITY_THRESHOLD。
FANQIE_OCR_MODELS=["PaddleOCR-VL-1.6", "PP-OCRv6", "PP-StructureV3"]
                                            # config.py::Config.fanqie_ocr_models

# 多模型字段融合的置信度阈值（0~1），低于阈值的字段被丢弃。
FANQIE_SIMILARITY_THRESHOLD=0.9              # config.py::Config.fanqie_similarity_threshold


# -----------------------------------------------------------------------------
# 5. 视觉模型兜底（OCR 失败时看图判定）
# Refs: config.py::Config
# -----------------------------------------------------------------------------

# 是否启用视觉模型兜底/复核。OCR 通过后视觉模型二次复核（持否决权）。
FANQIE_VISION_ENABLED=true                   # config.py::Config.fanqie_vision_enabled

# 视觉模型 OpenAI 兼容 API 地址。
FANQIE_VISION_API_BASE=https://api.deepseek.com
                                            # config.py::Config.fanqie_vision_api_base

# 视觉模型 API 密钥。
FANQIE_VISION_API_KEY=your-vision-key-here   # config.py::Config.fanqie_vision_api_key

# 视觉模型名称。
FANQIE_VISION_MODEL=deepseek-v4-flash-vision-exp
                                            # config.py::Config.fanqie_vision_model

# 视觉模型单次请求超时（秒）。
FANQIE_VISION_TIMEOUT=60                     # config.py::Config.fanqie_vision_timeout


# -----------------------------------------------------------------------------
# 6. nonebot-plugin-orm（SQLite）
# Refs: nonebot_plugin_orm 配置
# -----------------------------------------------------------------------------

# 是否在启动时自动检查数据库迁移。建议开发环境为 false。
ALEMBIC_STARTUP_CHECK=false                  # nonebot_plugin_orm::alembic_startup_check

# 插件使用的 SQLite 数据库地址。
SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:///fanqie.db   # nonebot_plugin_orm::SQLALCHEMY_DATABASE_URL

# 每个插件的独立数据库绑定（JSON）。本插件使用单库，无需额外配置。
# SQLALCHEMY_BINDS=
