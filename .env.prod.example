# =============================================================================
# ocr-fanqie-novel — Production Environment Template
# =============================================================================
# Copy to `.env.prod` (gitignored) and adjust each value for deployment.
#
# Production-specific recommendations:
#   - LOG_LEVEL=INFO                    (avoid DEBUG / TRACE in production)
#   - Disable FastAPI docs (set to empty) to reduce attack surface
#   - Use a strong random FANQIE_OCR_API_TOKEN
#   - Set FANQIE_KICK_ON_FAIL carefully per your moderation policy
# =============================================================================


# -----------------------------------------------------------------------------
# 1. NoneBot Core
# -----------------------------------------------------------------------------

# ENVIRONMENT=prod
# DRIVER=~fastapi+~httpx+~websockets
# HOST=0.0.0.0
# PORT=8080
# NICKNAME=ocr-fanqie-novel
# SUPERUSERS=["123456789"]
# LOG_LEVEL=INFO
# COMMAND_START=["/", ""]
# COMMAND_SEP=[".", " "]
# FASTAPI_OPENAPI_URL=
# FASTAPI_DOCS_URL=
# FASTAPI_REDOC_URL=


# -----------------------------------------------------------------------------
# 2. Localstore Paths
# -----------------------------------------------------------------------------

# LOCALSTORE_USE_CWD=true


# -----------------------------------------------------------------------------
# 3. OCR 验证插件
# -----------------------------------------------------------------------------

# FANQIE_VERIFY_GROUPS=[]
# FANQIE_WELCOME_MESSAGE=欢迎加入本群！为了验证您是真实的读者，请发送一张番茄小说阅读界面的截图。谢谢配合！
# FANQIE_RESPONSE_TIMEOUT=300
# FANQIE_MAX_ATTEMPTS=3
# FANQIE_MUTE_DURATION=600
# FANQIE_NOTIFY_ADMIN=true
# FANQIE_KICK_ON_FAIL=false
# FANQIE_KICK_ON_TIMEOUT=true


# -----------------------------------------------------------------------------
# 4. PaddleOCR 云端 API（PP-OCRv6）
# -----------------------------------------------------------------------------

# FANQIE_OCR_API_URL=https://your-ocr-api.example.com/ocr
# FANQIE_OCR_API_TOKEN=<override-with-strong-random-value>
# FANQIE_OCR_TIMEOUT=15


# -----------------------------------------------------------------------------
# 5. nonebot-plugin-orm（SQLite）
# -----------------------------------------------------------------------------

# 生产环境建议开启迁移检查，确保表结构与代码一致。
# ALEMBIC_STARTUP_CHECK=true
# SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:///fanqie.db
